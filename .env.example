# Copy to .env.local and fill in. .env.local is gitignored.

# Neon Postgres. Use the POOLED connection string (host contains "-pooler"),
# which is what serverless/edge runtimes need.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require"

# Shown on the contact page and used as the reply-to address.
CONTACT_EMAIL="hello@rexovi.com"
